generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
enum CoachRole{
  HEAD
  ASSISTANT_1
  ASSISTANT_2
  SAFETY
}

model Team {
  id      Int      @id @default(autoincrement())
  name    String
  code    String   @unique
  city    String
  players Player[]
  coaches Coach[]
}

model Coach{
  id Int @id @default(autoincrement())
  name String
  role CoachRole
  teamId Int 
  team Team @relation(fields: [teamId] ,references:[id], onDelete:Restrict )
  //@@unique([teamId,role])
}

model Player {
  id       Int    @id @default(autoincrement())
  name     String
  number   Int
  position String
  teamId   Int
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@unique([teamId, number])
}
